---
import {Icon as AstroIcon} from 'astro-icon/components';
---

<footer class="site-footer" aria-label="ReedworkMC website footer">
    <div class="footer-glow" aria-hidden="true"></div>

    <div class="footer-content">
        <!-- Brand -->
        <div class="footer-brand">
            <div class="brand">
                <span>ReedworkMC</span>
            </div>

            <p class="footer-description">
                Open-source tools, libraries and frameworks for Minecraft
                and PaperMC development.
            </p>

            <p class="footer-subdescription">
                Created by 0kAj. Built openly for Minecraft developers,
                with contributions from the community.
            </p>

            <div class="footer-status">
                <span>MINECRAFT · PAPERMC · JAVA · OPEN SOURCE</span>
            </div>
        </div>

        <!-- Projects -->
        <div class="footer-column">
            <h2>Projects</h2>

            <a href="/reedwork/">
                <AstroIcon name="mdi:code"/>
                <span>Reedwork</span>
            </a>

            <div class="footer-coming-soon">
                <AstroIcon name="mdi:database"/>
                <span>ReedworkConfig</span>
                <span class="coming-soon-label">Soon</span>
            </div>

            <div class="footer-coming-soon">
                <AstroIcon name="mdi:help-outline"/>
                <span>ReedworkUtils</span>
                <span class="coming-soon-label">Soon</span>
            </div>
        </div>

        <!-- Resources -->
        <div class="footer-column">
            <h2>Resources</h2>

            <a href="/reedwork/getting-started/introduction/">
                <AstroIcon name="mdi:book-open-outline"/>
                <span>Documentation</span>
            </a>

            <a href="https://github.com/ReedworkMC/ReedworkExamples"
               target="_blank"
               rel="noopener noreferrer">
                <AstroIcon name="mdi:github"/>
                <span>Examples</span>
                <AstroIcon name="mdi:open-in-new" class="external-icon"/>
            </a>

            <a href="https://github.com/ReedworkMC/Reedwork/releases"
               target="_blank"
               rel="noopener noreferrer">
                <AstroIcon name="mdi:tag-outline"/>
                <span>Releases</span>
                <AstroIcon name="mdi:open-in-new" class="external-icon"/>
            </a>

            <a href="https://github.com/ReedworkMC"
               target="_blank"
               rel="noopener noreferrer">
                <AstroIcon name="mdi:github"/>
                <span>GitHub</span>
                <AstroIcon name="mdi:open-in-new" class="external-icon"/>
            </a>
        </div>

        <!-- Community & Legal -->
        <div class="footer-column">
            <h2>Community</h2>

            <a href="https://github.com/ReedworkMC/Reedwork?tab=contributing-ov-file"
               target="_blank"
               rel="noopener noreferrer">
                <AstroIcon name="mdi:source-pull"/>
                <span>Contributing</span>
                <AstroIcon name="mdi:open-in-new" class="external-icon"/>
            </a>

            <a href="/legal-notice/">
                <AstroIcon name="mdi:legal"/>
                <span>Legal Notice</span>
            </a>

            <a href="/privacy-policy/">
                <AstroIcon name="mdi:security"/>
                <span>Privacy Policy</span>
            </a>

            <a href="/third-party-project-disclaimer/">
                <AstroIcon name="mdi:information-outline"/>
                <span>Third-party Disclaimer</span>
            </a>
        </div>
    </div>

    <!-- Legal Disclaimer -->
    <div class="footer-legal-disclaimer">
        <p>
            ReedworkMC is an independent open-source development project
            and is not affiliated with, endorsed by, or sponsored by
            PaperMC, Mojang Studios, or Microsoft.
        </p>

        <p>
            ReedworkMC is an independent, privately maintained open-source project and is not affiliated with, endorsed by, or sponsored by PaperMC, Mojang Studios, or Microsoft.
            <br>
            Minecraft, PaperMC, and related names, logos, and marks are trademarks of their respective owners. References to these names do not imply any affiliation or endorsement.
            <br>
            <a href="/third-party-project-disclaimer/">
                Third-party disclaimer
            </a>
        </p>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
        <span>
            © 2026-present 0kAj and contributors
        </span>

        <span>
            Icons by <a href="https://github.com/Templarian/MaterialDesign"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Open Material Design Icons GitHub repository">
                Material Design Icons
            </a>
        </span>
    </div>
</footer>

<style>
    @layer starlight.components {
        .site-footer {
            position: relative;
            overflow: hidden;

            margin-top: 5rem;
            padding: 0 1.5rem 1.5rem;

            border-top: 1px solid rgba(255, 255, 255, 0.08);

            background: radial-gradient(
                    circle at 12% 100%,
                    rgba(34, 211, 238, 0.055),
                    transparent 28%
            ),
            radial-gradient(
                    circle at 88% 0%,
                    rgba(139, 92, 246, 0.08),
                    transparent 30%
            );
        }

        .footer-glow {
            position: absolute;
            top: -1px;
            left: 0;
            right: 0;

            height: 1px;

            background: linear-gradient(
                    90deg,
                    transparent 0%,
                    rgba(139, 92, 246, 0.65) 30%,
                    rgba(34, 211, 238, 0.65) 70%,
                    transparent 100%
            );

            opacity: 0.8;
        }

        .footer-content {
            position: relative;

            max-width: 1200px;
            margin: 0 auto;
            padding: 4rem 0 3.5rem;

            display: grid;
            grid-template-columns:
                minmax(0, 1.7fr)
                repeat(3, minmax(0, 1fr));
            gap: 3rem;
        }

        .footer-coming-soon {
            display: flex;
            align-items: center;
            gap: 0.6rem;

            min-width: 0;

            color: var(--sl-color-gray-4);
            font-size: var(--sl-text-sm);
            line-height: 1.5;
            opacity: 0.7;
        }

        .footer-coming-soon svg {
            width: 1.05em;
            height: 1.05em;
            flex-shrink: 0;
        }

        .coming-soon-label {
            margin-left: auto;

            color: var(--sl-color-gray-5);
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        /* ─────────────────────────────────────────
           Brand
           ───────────────────────────────────────── */
        .footer-brand {
            min-width: 0;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;

            font-size: 1.35rem;
            font-weight: 750;
            letter-spacing: -0.02em;
        }

        .brand span {
            background: var(--rw-gradient);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
        }

        .footer-description {
            max-width: 28rem;

            margin: 1.25rem 0 0;

            color: var(--sl-color-gray-2);

            font-size: var(--sl-text-sm);
            line-height: 1.6;
        }

        .footer-subdescription {
            max-width: 28rem;

            margin: 0.35rem 0 0;

            color: var(--sl-color-gray-4);

            font-size: var(--sl-text-xs);
            line-height: 1.6;
        }

        .footer-status {
            display: flex;
            align-items: center;

            margin-top: 1.75rem;

            color: var(--sl-color-gray-4);

            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.16em;
        }

        /* ─────────────────────────────────────────
           Navigation
           ───────────────────────────────────────── */
        .footer-column {
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
        }

        .footer-column h2 {
            margin: 0 0 0.65rem;

            color: var(--sl-color-white);

            font-size: var(--sl-text-xs);
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .footer-column a {
            display: flex;
            align-items: center;
            gap: 0.6rem;

            min-width: 0;

            color: var(--sl-color-gray-4);
            font-size: var(--sl-text-sm);
            line-height: 1.5;
            text-decoration: none;

            transition: color 0.15s ease;
        }

        .footer-column a svg {
            width: 1.05em;
            height: 1.05em;
            flex-shrink: 0;

            color: var(--sl-color-gray-4);

            transition: color 0.15s ease;
        }

        .footer-column a:hover {
            color: var(--sl-color-white);
        }

        .footer-column a:hover .external-icon {
            color: var(--rw-cyan-light);
        }

        .external-icon {
            width: 0.85em !important;
            height: 0.85em !important;

            margin-left: auto;

            color: var(--sl-color-gray-5);
        }

        /* ─────────────────────────────────────────
           Disclaimer
           ───────────────────────────────────────── */

        .footer-legal-disclaimer {
            position: relative;
            z-index: 1;

            display: block;

            width: 100%;
            max-width: 1200px;
            margin: 0 auto;

            padding: 1.5rem 0;

            border-top: 1px solid rgba(255, 255, 255, 0.08);

            color: var(--sl-color-gray-3);

            font-size: 0.75rem;
            line-height: 1.6;

            opacity: 1;
        }

        .footer-legal-disclaimer p {
            display: block;

            max-width: 70rem;
            margin: 0;

            color: var(--sl-color-gray-3);
        }

        .footer-legal-disclaimer p + p {
            margin-top: 0.35rem;
        }

        .footer-legal-disclaimer a {
            display: inline-block;

            margin-top: 0.5rem;

            color: var(--sl-color-gray-2);
            text-decoration: underline;
            text-decoration-color: var(--sl-color-gray-5);
            text-underline-offset: 0.15em;

            transition:
                    color 0.15s ease,
                    text-decoration-color 0.15s ease;
        }

        .footer-legal-disclaimer a:hover {
            color: var(--sl-color-white);
            text-decoration-color: var(--sl-color-gray-3);
        }

        /* ─────────────────────────────────────────
           Bottom
           ───────────────────────────────────────── */
        .footer-bottom {
            position: relative;

            max-width: 1200px;
            margin: 0 auto;

            padding-top: 1.25rem;

            border-top: 1px solid rgba(255, 255, 255, 0.06);

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;

            color: var(--sl-color-gray-4);

            font-size: var(--sl-text-xs);
        }

        .footer-bottom a {
            color: var(--sl-color-gray-3);
            text-decoration: none;

            transition: color 0.15s ease;
        }

        .footer-bottom a:hover {
            color: var(--sl-color-gray-2);
        }

        /* ─────────────────────────────────────────
           Responsive
           ───────────────────────────────────────── */
        @media (max-width: 900px) {
            .footer-content {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 2.5rem;
            }

            .footer-brand {
                grid-column: 1 / -1;
            }
        }

        @media (max-width: 700px) {
            .footer-content {
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }

            .footer-brand {
                grid-column: auto;
            }
        }
    }
</style>
