---
import {Icon as AstroIcon} from 'astro-icon/components';
import {Icon as StarlightIcon} from '@astrojs/starlight/components';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'title'> {
    title: string;
    icon?: string;
}

const { title, icon, href, ...attributes } = Astro.props;
---

<a class="card" href={href} {...attributes}>
    <div class="title-row">
        <p class="title sl-flex">
            {icon && <AstroIcon name={icon} class="icon" size="1.333em" />}
            <span set:html={title} />
        </p>

        {href && (
            <StarlightIcon
                name="right-arrow"
                size="1.333em"
                class="arrow rtl:flip"
            />
        )}
    </div>

    <div class="body"><slot /></div>
</a>

<style>
    @layer starlight.components {
        .card {
            --sl-card-border: var(--sl-color-purple);
            --sl-card-bg: var(--sl-color-purple-low);

            border: 1px solid var(--sl-color-gray-5);
            background-color: var(--sl-color-black);
            padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);

            display: flex;
            flex-direction: column;
            gap: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);

            text-decoration: none;

            transition:
                background-color 0.2s ease,
                border-color 0.2s ease;
        }

        .card:nth-child(4n + 1) {
            --sl-card-border: var(--sl-color-orange);
            --sl-card-bg: var(--sl-color-orange-low);
        }

        .card:nth-child(4n + 3) {
            --sl-card-border: var(--sl-color-green);
            --sl-card-bg: var(--sl-color-green-low);
        }

        .card:nth-child(4n + 4) {
            --sl-card-border: var(--sl-color-red);
            --sl-card-bg: var(--sl-color-red-low);
        }

        .card:nth-child(4n + 5) {
            --sl-card-border: var(--sl-color-blue);
            --sl-card-bg: var(--sl-color-blue-low);
        }

        .title-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .title {
            margin: 0;
            font-weight: 600;
            font-size: var(--sl-text-h4);
            color: var(--sl-color-white);
            line-height: var(--sl-line-height-headings);
            gap: 1rem;
            align-items: center;
        }

        .card .icon {
            border: 1px solid var(--sl-card-border);
            background-color: var(--sl-card-bg);
            padding: 0.2em;
            border-radius: 0.25rem;
            flex-shrink: 0;
        }

        .card .body {
            margin: 0;
            font-size: clamp(
                var(--sl-text-sm),
                calc(0.5rem + 1vw),
                var(--sl-text-body)
            );
        }

        .arrow {
            color: var(--sl-color-gray-3);
            flex-shrink: 0;
            transition: color 0.2s ease;
        }

        .card:hover {
            background-color: var(--sl-card-bg);
            border-color: var(--sl-card-border);
        }

        .card:hover .arrow {
            color: var(--sl-color-white);
        }
    }
</style>